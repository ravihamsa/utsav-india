# Copy to .env.local for local development with Supabase, and add the same
# variables to your Vercel project (Settings -> Environment Variables).
# Find the Supabase values under Project Settings -> API.
# Use the anon/publishable key only — never the service_role key in a frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Absolute public URL used for canonical + social share tags on Vercel.
VITE_SITE_URL=https://utsav-india.vercel.app
