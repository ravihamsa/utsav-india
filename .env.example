# Copy to .env.local for local development with Supabase, and add the same two
# variables to your Vercel project (Settings -> Environment Variables).
# Find these under Supabase Dashboard -> Project Settings -> API.
# Use the anon/public key only — never the service_role key in a frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
